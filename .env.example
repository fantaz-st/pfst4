WP_GRAPHQL_ENDPOINT=https://backend.pfst.hr/graphql
NEXT_PUBLIC_SITE_URL=https://pfst.unist.hr

# Shared secret the WordPress mu-plugin sends to /api/revalidate.
WP_REVALIDATE_SECRET=

# Shared secret required by /api/preview links.
WP_PREVIEW_SECRET=

# WordPress Application Password used to authenticate preview (asPreview)
# GraphQL requests, so unpublished drafts and revisions are visible.
WP_PREVIEW_USER=
WP_PREVIEW_APP_PASSWORD=

# true on staging / preview deployments: robots.txt disallows everything and
# every page gets noindex. Leave unset (or false) in production.
SITE_NOINDEX=

# Sceduly REST API (Raspored, Konzultacije → timetable links). Server only.
# Without these the timetable page shows "Raspored trenutačno nije dostupan".
SCEDULY_USER=
SCEDULY_INSTITUTION_ID=
SCEDULY_PASSWORD=
SCEDULY_LOCATION=

# Vercel sends this as "Authorization: Bearer …" to the daily cron
# (/api/cron/sceduly, scheduled in vercel.json). Any long random string.
CRON_SECRET=
