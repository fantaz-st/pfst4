WP_GRAPHQL_ENDPOINT=https://backend.pfst.hr/graphql
NEXT_PUBLIC_SITE_URL=https://pfst.unist.hr

# Shared secret the WordPress mu-plugin sends to /api/revalidate.
WP_REVALIDATE_SECRET=

# Shared secret required by /api/preview links.
WP_PREVIEW_SECRET=

# WordPress Application Password used to authenticate preview (asPreview)
# GraphQL requests, so unpublished drafts and revisions are visible.
WP_PREVIEW_USER=
WP_PREVIEW_APP_PASSWORD=
